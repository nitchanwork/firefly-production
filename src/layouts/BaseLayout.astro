---
import Navbar from "../components/Navbar.astro";
import Analytics from "../components/Analytics.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  theme?: "light" | "dark";
  contentWidth?: "wide" | "default" | "medium" | "narrow";
}

const {
  title = "FIREFLY PRODUCTION HOUSE",
  description = "FIREFLY PRODUCTION HOUSE — creative production for photography, video and content in Bangkok, Thailand.",
  image,
  theme = "light",
  contentWidth = "default",
  noindex = false
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ?? new URL('https://nitchanwork.github.io');
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const socialImageUrl = image
  ? new URL(image, site).toString()
  : new URL(`${base}/og-image.png`, site).toString();

---

<!doctype html>
<html lang="en" class:list={{ "theme-dark": theme === "dark" }}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FIREFLY PRODUCTION HOUSE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon-browser.svg`} />
    <link rel="preconnect" href="https://www.instagram.com" />
    <link rel="dns-prefetch" href="https://www.instagram.com" />
    <link rel="preconnect" href="https://static.cdninstagram.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@400;500;700&family=Josefin+Sans:wght@700&display=swap" rel="stylesheet" />
    <Analytics />
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navbar />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <slot name="project-cta" />
    <Footer contentWidth={contentWidth} />
  </body>
</html>
