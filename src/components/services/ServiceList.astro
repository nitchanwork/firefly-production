---
import { categories, services } from '../../data/services';
import ServiceItem from './ServiceItem.astro';
import ProductionBuilder from './ProductionBuilder.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const contactHref = `${base}/contact/`;
---

<div class="service-browser">
  <ProductionBuilder />
  <p class="results-count" role="status" aria-live="polite" aria-atomic="true">{services.length} SERVICES AVAILABLE</p>
  <div id="service-results">
    {categories.map(category => <section class="service-category" data-service-category={category.id} aria-labelledby={`${category.id}-heading`}>
      <h2 id={`${category.id}-heading`}>{category.title}</h2>
      {services.filter(service => service.category === category.id).map(service => <ServiceItem service={service} />)}
    </section>)}
  </div>
  <section class="empty-state" data-empty-state hidden aria-labelledby="empty-title">
    <h2 id="empty-title">NO SERVICES<br />WITHIN THIS SETUP</h2>
    <p>Try increasing your budget or selecting a different service.</p>
    <a href={contactHref} data-analytics-event="packages_empty_start_project" data-analytics-label="Start a project">START A PROJECT <span aria-hidden="true">→</span></a>
  </section>
</div>

<noscript>
  <style>.service-panel[hidden] { display: block; } .details-toggle, .production-builder { display: none; }</style>
</noscript>

<script>
  document.querySelectorAll<HTMLElement>('.service-browser').forEach(browser => {
    const groups = browser.querySelectorAll<HTMLElement>('.service-category');
    const items = browser.querySelectorAll<HTMLElement>('.service-item');
    const toggles = browser.querySelectorAll<HTMLButtonElement>('.details-toggle');
    const budgetInput = browser.querySelector<HTMLInputElement>('[data-budget]')!;
    const budgetError = browser.querySelector<HTMLElement>('[data-budget-error]')!;
    const emptyState = browser.querySelector<HTMLElement>('[data-empty-state]')!;
    const formatter = new Intl.NumberFormat('en-US', { maximumFractionDigits: 20 });
    const needs = browser.querySelectorAll<HTMLButtonElement>('[data-need]');
    const state: { budget: number | null; selectedCategories: Set<string> } = {
      budget: null, selectedCategories: new Set(),
    };

    function setSelected(button: HTMLButtonElement, selected: boolean) {
      button.setAttribute('aria-pressed', String(selected));
      const icon = button.querySelector('[data-selection-icon]');
      if (icon) icon.textContent = selected ? '✓' : '+';
    }

    function setExpanded(button: HTMLButtonElement, expanded: boolean) {
      const panel = document.getElementById(button.getAttribute('aria-controls')!);
      if (!panel) return;
      panel.hidden = !expanded;
      button.setAttribute('aria-expanded', String(expanded));
      button.querySelector('[data-toggle-label]')!.textContent = expanded ? 'Close Details' : 'View Details';
      button.querySelector('[data-toggle-icon]')!.textContent = expanded ? '−' : '+';
    }

    function applyFilters() {
      const invalid = !budgetInput.validity.valid;
      state.budget = budgetInput.value === '' || invalid ? null : budgetInput.valueAsNumber;
      budgetError.hidden = !invalid;
      budgetInput.setAttribute('aria-invalid', String(invalid));
      toggles.forEach(toggle => setExpanded(toggle, false));
      let count = 0;
      items.forEach(item => {
        const category = item.dataset.serviceCategory!;
        const matchesCategory = state.selectedCategories.size === 0 || state.selectedCategories.has(category);
        const matchesBudget = state.budget === null || Number(item.dataset.startingPrice) <= state.budget;
        item.hidden = !(matchesCategory && matchesBudget);
        if (!item.hidden) count++;
      });
      groups.forEach(group => {
        group.hidden = !group.querySelector('.service-item:not([hidden])');
      });
      emptyState.hidden = count > 0;
      const selected = Array.from(needs).filter(button => state.selectedCategories.has(button.dataset.need!));
      const categoryText = selected.length === 1 ? ` ${selected[0].querySelector('[data-need-label]')!.textContent}` : '';
      const budgetText = state.budget === null ? (selected.length === 0 ? ' AVAILABLE' : '') : ` WITHIN ฿${formatter.format(state.budget)}`;
      browser.querySelector('[role="status"]')!.textContent = `${count}${categoryText} ${count === 1 ? 'SERVICE' : 'SERVICES'}${budgetText}${invalid ? '. Enter a valid budget of zero or more; budget filtering is paused.' : ''}`;
    }

    needs.forEach(button => button.addEventListener('click', () => {
      const need = button.dataset.need!;
      if (state.selectedCategories.has(need)) state.selectedCategories.delete(need);
      else state.selectedCategories.add(need);
      setSelected(button, state.selectedCategories.has(need));
      applyFilters();
    }));
    function clearServices() {
      state.selectedCategories.clear();
      needs.forEach(button => setSelected(button, false));
    }
    browser.querySelector('[data-clear-services]')!.addEventListener('click', () => {
      clearServices();
      applyFilters();
    });
    browser.querySelector('[data-clear-all]')!.addEventListener('click', () => {
      budgetInput.value = '';
      clearServices();
      applyFilters();
    });
    budgetInput.addEventListener('input', applyFilters);
    browser.querySelector('[data-clear-budget]')!.addEventListener('click', () => {
      budgetInput.value = '';
      applyFilters();
      budgetInput.focus();
    });
    applyFilters();

    toggles.forEach(button => button.addEventListener('click', () => {
      const expand = button.getAttribute('aria-expanded') !== 'true';
      toggles.forEach(toggle => setExpanded(toggle, toggle === button && expand));
    }));
  });
</script>

<style>
  .results-count { margin: 0 0 24px; padding-block: 24px; border-block: 1px solid var(--line); color: var(--muted); font-size: 12px; line-height: 1.6; }
  .service-category { margin-top: 64px; }
  h2 { margin: 0 0 24px; font-size: 12px; font-weight: 400; letter-spacing: .1em; }
  .empty-state { padding-block: 64px; border-bottom: 1px solid var(--line); }
  .empty-state h2 { font-size: clamp(30px, 4vw, 64px); line-height: 1; letter-spacing: -.04em; font-weight: 500; }
  .empty-state p { max-width: 440px; color: var(--muted); line-height: 1.6; font-size: 14px; }
  .empty-state a { display: inline-flex; align-items: center; gap: 32px; min-height: 48px; margin-top: 16px; border-bottom: 1px solid var(--text); font-size: 13px; }
  .empty-state a:focus-visible { outline: 2px solid var(--text); outline-offset: 5px; }
  @media (max-width: 768px) { .service-category { margin-top: 48px; } }
</style>
