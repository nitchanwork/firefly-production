---
import { formatPrice, type Service } from '../../data/services';
import ServiceDetails from './ServiceDetails.astro';
interface Props { service: Service }
const { service } = Astro.props;
const titleId = `${service.id}-title`;
const panelId = `${service.id}-details`;
---

<article class="service-item" aria-labelledby={titleId} data-service-category={service.category} data-starting-price={service.startingPrice}>
  <div class="service-summary">
    <span class="number">{service.number}</span>
    <div class="description">
      <h3 id={titleId}>{service.title}</h3>
      <p>{service.shortDescription}</p>
    </div>
    <div class="pricing">
      <p class="duration">{service.duration}</p>
      <p class="price">{service.priceType === 'from' ? 'From ' : ''}{formatPrice(service.startingPrice)}</p>
      <p class="vat">VAT 7% excluded · WHT 3% applies where applicable</p>
      <button type="button" class="details-toggle" aria-expanded="false" aria-controls={panelId} aria-describedby={titleId}>
        <span data-toggle-label>View Details</span> <span aria-hidden="true" data-toggle-icon>+</span>
      </button>
    </div>
  </div>
  <div id={panelId} class="service-panel" hidden>
    <ServiceDetails service={service} />
  </div>
</article>

<style>
  .service-item { border-top: 1px solid var(--line); }
  .service-summary { display: grid; grid-template-columns: 48px minmax(0, 1fr) 240px; gap: 32px; padding-block: 40px; }
  .number { color: var(--muted); font-size: 13px; padding-top: 5px; }
  h3 { margin: 0; max-width: 780px; font-size: clamp(24px, 2.5vw, 40px); font-weight: 400; letter-spacing: -.035em; line-height: 1.15; }
  .description p { margin: 16px 0 0; color: var(--muted); font-size: 14px; line-height: 1.5; }
  .pricing { text-align: right; }
  .duration { margin: 0 0 12px; color: var(--muted); font-size: 12px; }
  .price { margin: 0; font-size: clamp(22px, 2vw, 28px); letter-spacing: -.03em; }
  .vat { margin: 8px 0 0; color: var(--muted); font-size: 11px; }
  button { display: inline-flex; align-items: center; gap: 28px; min-height: 44px; margin-top: 16px; padding: 8px 0; background: transparent; color: var(--text); border: 0; border-bottom: 1px solid var(--line); font: inherit; font-size: 13px; cursor: pointer; }
  button:hover { border-color: var(--text); }
  button:focus-visible { outline: 2px solid var(--text); outline-offset: 5px; }
  .service-panel { margin-left: 80px; overflow-wrap: anywhere; }
  @media (max-width: 1024px) { .service-summary { grid-template-columns: 32px minmax(0, 1fr) 200px; gap: 24px; } .service-panel { margin-left: 56px; } }
  @media (max-width: 768px) {
    .service-summary { grid-template-columns: 24px minmax(0, 1fr); gap: 20px 16px; padding-block: 32px; }
    .pricing { grid-column: 2; text-align: left; }
    .service-panel { margin-left: 40px; }
  }
  @media (max-width: 540px) { .service-panel { margin-left: 0; } }
</style>
