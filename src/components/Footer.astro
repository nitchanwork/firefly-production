---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner container">
    <div class="footer-lead">
      <p class="eyebrow">FIREFLY PRODUCTION HOUSE</p>
      <a
        class="project-link"
        href={href("/contact/")}
        data-analytics-event="footer_start_project"
        data-analytics-label="Start a project"
      >
        <span>START A PROJECT</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="footer-grid">
      <div>
        <p class="label">BASE</p>
        <p>Bangkok, Thailand</p>
      </div>

      <div>
        <p class="label">CONTACT</p>
        <a
          href="mailto:nitchan@jytecom.com"
          data-analytics-event="footer_email"
          data-analytics-label="nitchan@jytecom.com"
        >
          nitchan@jytecom.com
        </a>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <p class="label">EXPLORE</p>
        <a href={href("/")}>Home</a>
        <a href={href("/portfolio/")}>Portfolio</a>
        <a href={href("/packages/")}>Packages</a>
        <a href={href("/contact/")}>Contact</a>
      </nav>
    </div>

    <div class="footer-bottom">
      <span>© {year} Firefly Production House</span>
      <span>Creative production for photo, video and content.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg);
  }

  .footer-inner {
    padding-block: clamp(56px, 7vw, 96px) 32px;
  }

  .footer-lead {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 520px);
    align-items: start;
    gap: 48px;
    padding-bottom: clamp(56px, 7vw, 96px);
  }

  .eyebrow,
  .label {
    margin: 0;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: .12em;
  }

  .project-link {
    display: flex;
    justify-content: space-between;
    gap: 48px;
    padding-block: 14px;
    border-block: 1px solid var(--line);
    font-size: clamp(20px, 2.2vw, 34px);
    font-weight: 500;
    letter-spacing: -.03em;
    transition: border-color .2s ease;
  }

  .project-link:hover {
    border-color: #666;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    padding-block: 32px 56px;
    border-top: 1px solid var(--line);
  }

  .footer-grid p:not(.label),
  .footer-grid a {
    margin: 12px 0 0;
    font-size: 13px;
    line-height: 1.6;
  }

  .footer-grid a {
    width: fit-content;
    transition: opacity .2s ease;
  }

  .footer-grid a:hover {
    opacity: .55;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 10px;
    letter-spacing: .03em;
  }

  @media (max-width: 768px) {
    .footer-lead,
    .footer-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .footer-lead {
      gap: 28px;
    }

    .project-link {
      width: 100%;
    }

    .footer-grid {
      gap: 36px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
