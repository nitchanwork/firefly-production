---
import { portfolioBrands } from "../data/portfolio";

interface Props {
  contentWidth?: "wide" | "default" | "medium" | "narrow";
}

const { contentWidth = "default" } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
const year = new Date().getFullYear();
const partnerLinks = [
  { label: 'HAAB', brandId: 'haab' },
  { label: 'LAYERS', brandId: 'layers' },
  { label: 'HAROY', brandId: 'haroy' },
  { label: 'YOGURBARA', brandId: 'yogurbara' },
  { label: 'SUSHI POP', brandId: 'sushi-pop' },
  { label: 'HATCH BY HAAB', brandId: 'hatch' },
];

const partners = partnerLinks.map(partner => ({
  ...partner,
  href: portfolioBrands.find(brand => brand.id === partner.brandId)?.instagramProfileUrl,
}));
---

<footer class="site-footer">
  <div class:list={["footer-inner", "container", `footer-${contentWidth}`]}>
    <p class="eyebrow">FIREFLY PRODUCTION HOUSE</p>

    <div class="footer-grid">
      <div>
        <p class="label">BASE</p>
        <p>Bangkok, Thailand</p>
      </div>

      <div>
        <p class="label">CONTACT</p>
        <a
          href="mailto:nitchan@jytecom.com"
          data-analytics-event="footer_email"
          data-analytics-label="nitchan@jytecom.com"
        >
          nitchan@jytecom.com
        </a>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <p class="label">EXPLORE</p>
        <a href={href("/")}>Home</a>
        <a href={href("/portfolio/")}>Portfolio</a>
        <a href={href("/packages/")}>Packages</a>
        <a href={href("/contact/")}>Contact</a>
      </nav>

      <nav class="partner-nav" aria-label="Our partner brands">
        <p class="label">OUR PARTNER</p>
        {partners.map(partner => partner.href ? (
          <a
            href={partner.href}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="footer_partner"
            data-analytics-label={partner.label}
          >
            {partner.label}
          </a>
        ) : (
          <span>{partner.label}</span>
        ))}
      </nav>
    </div>

    <div class="footer-bottom">
      <span>© {year} Firefly Production House</span>
      <span>Creative production for photo, video and content.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg);
  }

  .footer-inner {
    padding-block: clamp(56px, 7vw, 96px) 32px;
  }

  .footer-wide { --max-width: var(--content-wide); }
  .footer-default { --max-width: var(--content-default); }
  .footer-medium { --max-width: var(--content-medium); }
  .footer-narrow { --max-width: var(--content-narrow); }

  .eyebrow {
    padding-bottom: 32px;
  }

  .eyebrow,
  .label {
    margin: 0;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: .12em;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    padding-block: 32px 56px;
    border-top: 1px solid var(--line);
  }

  .footer-grid p:not(.label),
  .footer-grid a,
  .footer-grid span {
    margin: 12px 0 0;
    font-size: 13px;
    line-height: 1.6;
  }

  .footer-grid a {
    width: fit-content;
    transition: opacity .2s ease;
  }

  .footer-grid a:hover {
    opacity: .55;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .partner-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 10px;
    letter-spacing: .03em;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .footer-grid {
      gap: 36px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
