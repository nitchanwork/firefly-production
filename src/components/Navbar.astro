---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
const localPath = base && Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length) || '/'
  : Astro.url.pathname;

const links = [
  { path: '/', label: 'Home' },
  { path: '/portfolio/', label: 'Portfolio' },
  { path: '/packages/', label: 'Packages' },
  { path: '/contact/', label: 'Contact' },
];

const isCurrent = (path: string) =>
  path === '/' ? localPath === '/' : localPath.startsWith(path);
---

<nav class="navbar" aria-label="Primary navigation">
  <div class="navbar-inner">
    <a class="logo" href={href("/")} data-analytics-event="navigation" data-analytics-label="Firefly logo">
      <img class="logo-icon" src={`${base}/favicon.svg`} alt="" aria-hidden="true" />
      <span>FIREFLY</span>
    </a>

    <div class="menu">
      {links.map(item => (
        <a
          href={href(item.path)}
          aria-current={isCurrent(item.path) ? "page" : undefined}
          data-analytics-event="navigation"
          data-analytics-label={item.label}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: 24px 32px;
    mix-blend-mode: difference;
    color: white;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    max-width: 1600px;
    margin-inline: auto;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .logo-icon {
    display: block;
    width: 20px;
    height: 20px;
    max-width: none;
    flex: 0 0 20px;
    object-fit: contain;
  }

  .menu {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 32px;
    min-width: 0;
  }

  .menu a {
    position: relative;
    flex: 0 0 auto;
    padding-block: 3px;
    font-size: 14px;
    line-height: 1;
    white-space: nowrap;
    transition: opacity .2s ease;
  }

  .menu a:hover {
    opacity: .55;
  }

  .menu a[aria-current="page"]::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -5px;
    left: 0;
    height: 1px;
    background: currentColor;
  }

  @media (max-width: 1024px) {
    .navbar {
      padding: 22px 24px;
    }

    .navbar-inner {
      gap: 20px;
    }

    .logo {
      gap: 7px;
      font-size: 16px;
    }

    .logo-icon {
      width: 18px;
      height: 18px;
      flex-basis: 18px;
    }

    .menu {
      gap: 20px;
    }

    .menu a {
      font-size: 13px;
    }
  }

  @media (max-width: 768px) {
    .navbar {
      padding: 18px 20px;
    }

    .navbar-inner {
      gap: 14px;
    }

    .logo {
      gap: 6px;
      font-size: 15px;
    }

    .logo-icon {
      width: 17px;
      height: 17px;
      flex-basis: 17px;
    }

    .menu {
      gap: 12px;
    }

    .menu a {
      font-size: 12px;
    }
  }

  @media (max-width: 480px) {
    .navbar {
      padding: 16px;
    }

    .navbar-inner {
      gap: 10px;
    }

    .logo {
      gap: 5px;
      font-size: 13px;
    }

    .logo-icon {
      width: 15px;
      height: 15px;
      flex-basis: 15px;
    }

    .menu {
      gap: 8px;
    }

    .menu a {
      font-size: 10px;
      letter-spacing: -.01em;
    }
  }
</style>
