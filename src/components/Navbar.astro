---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
---

<nav class="navbar">
  <div class="navbar-inner">
    <a class="logo" href={href("/")}>
      FIREFLY
    </a>

    <div class="menu">
      <a href={href("/")}>Home</a>
      <a href={href("/portfolio/")}>Portfolio</a>
      <a href={href("/packages/")}>Packages</a>
      <a href={href("/contact/")}>Contact</a>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;

    z-index: 100;

    padding: 24px 32px;

    mix-blend-mode: difference;
    color: white;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;
    max-width: 1600px;
    margin-inline: auto;
  }

  .logo {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .menu {
    display: flex;
    gap: 32px;
  }

  .menu a {
    font-size: 14px;
    transition: opacity 0.2s ease;
  }

  .menu a:hover {
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .navbar {
      padding: 20px;
    }

    .menu {
      gap: 16px;
    }

    .menu a {
      font-size: 12px;
    }
  }
</style>