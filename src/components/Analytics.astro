---
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
---

{measurementId && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>
    <script is:inline define:vars={{ measurementId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', measurementId, { anonymize_ip: true });

      document.addEventListener('click', function (event) {
        var target = event.target instanceof Element
          ? event.target.closest('[data-analytics-event]')
          : null;
        if (!target || typeof window.gtag !== 'function') return;

        window.gtag('event', target.getAttribute('data-analytics-event'), {
          event_label: target.getAttribute('data-analytics-label') || (target.textContent || '').trim()
        });
      });
    </script>
  </>
)}
