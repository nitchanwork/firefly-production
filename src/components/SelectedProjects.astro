---
import ProjectCard from "./ProjectCard.astro";

// Sample projects and covers; replace with the final portfolio content.
const selectedProjects = [
  { name: "After Hours", client: "Sample Client 01", category: "Brand Film", year: "2026" },
  { name: "Everyday Rituals", client: "Sample Client 02", category: "Photography", year: "2026" },
  { name: "In Motion", client: "Sample Client 03", category: "Campaign", year: "2025" },
  { name: "New Perspectives", client: "Sample Client 04", category: "Social Content", year: "2025" },
];
---

<section class="selected-projects container" aria-labelledby="selected-projects-title">
  <h2 id="selected-projects-title">Selected Works</h2>
  <div class="projects-grid">
    {selectedProjects.map((project) => (
      <ProjectCard
        {...project}
        image="/images/project-placeholder.svg"
        imageAlt="Placeholder project cover"
      />
    ))}
  </div>
</section>

<style>
  .selected-projects {
    padding-block: 100px;
  }

  h2 {
    margin: 0 0 48px;
    font-size: clamp(36px, 5vw, 72px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px 32px;
  }

  @media (max-width: 768px) {
    .selected-projects {
      padding-block: 64px;
    }

    h2 {
      margin-bottom: 32px;
    }

    .projects-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
</style>
