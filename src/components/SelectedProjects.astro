---
import PortfolioBrand from "./portfolio/PortfolioBrand.astro";
import { portfolioBrands } from "../data/portfolio";
---

<section class="selected-projects container" aria-labelledby="selected-projects-title">
  <h2 id="selected-projects-title">WHAT WE MAKE</h2>
  <div class="projects-grid">
    {portfolioBrands.map(brand => (
      <PortfolioBrand brand={{
        ...brand,
        // No publishedAt metadata yet: preserve the Portfolio source order.
        photography: brand.photography.slice(0, 5),
        videography: brand.videography.slice(0, 5),
      }} />
    ))}
  </div>
</section>

<style>
  .selected-projects {
    padding-block: 100px;
  }

  h2 {
    margin: 0 0 48px;
    font-size: clamp(36px, 5vw, 72px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
  }

  .selected-projects :global(.type-count) { display: none; }

  @media (max-width: 768px) {
    .selected-projects {
      padding-block: 64px;
    }

    h2 {
      margin-bottom: 32px;
    }

    .projects-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 56px;
    }
  }
</style>
