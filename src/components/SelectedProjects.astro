---
import PortfolioBrand from "./portfolio/PortfolioBrand.astro";
import { portfolioBrands, sortPortfolioPosts } from "../data/portfolio";

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const portfolioHref = `${base}/portfolio/`;
---

<section class="selected-projects container" aria-labelledby="selected-projects-title" data-instagram-eager>
  <h2 id="selected-projects-title">WHAT WE MAKE</h2>

  <div class="projects-grid">
    {portfolioBrands.map(brand => (
      <PortfolioBrand brand={{
        ...brand,
        photography: sortPortfolioPosts(brand.photography).slice(0, 5),
        videography: sortPortfolioPosts(brand.videography).slice(0, 5),
      }} />
    ))}
  </div>

  <div class="portfolio-cta-wrap">
    <a
      class="portfolio-cta"
      href={portfolioHref}
      data-analytics-event="home_portfolio_cta"
      data-analytics-label="View full portfolio"
    >
      <span>VIEW FULL PORTFOLIO</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .selected-projects {
    --max-width: var(--content-wide);
    padding-block: var(--space-section);
  }

  h2 {
    margin: 0 0 clamp(36px, 5vw, 64px);
    font-size: clamp(36px, 5vw, 72px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-brand);
  }

  .selected-projects :global(.type-count) {
    display: none;
  }

  .portfolio-cta-wrap {
    display: flex;
    justify-content: flex-end;
    padding-top: clamp(12px, 3vw, 36px);
  }

  .portfolio-cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    min-width: min(100%, 360px);
    padding: 18px 0 14px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .1em;
    transition: transform var(--interaction-motion);
  }

  .portfolio-cta:hover {
    transform: scale(1.015);
  }

  .portfolio-cta:active { transform: scale(0.985); }

  @media (max-width: 768px) {
    h2 {
      margin-bottom: 32px;
    }

    .projects-grid {
      gap: var(--space-brand);
    }

    .portfolio-cta-wrap {
      padding-top: 12px;
    }

    .portfolio-cta {
      width: 100%;
      min-width: 0;
    }
  }
</style>
