---
interface Props {
  theme?: "light" | "dark";
}

const { theme = "light" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const contactHref = `${base}/contact/`;
---

<section class="project-section" data-theme={theme} aria-labelledby="project-cta-title">
  <div class="project-cta container">
      <h2 id="project-cta-title">NOT SURE<br />WHAT FITS?</h2>
      <div>
        <p>Tell us what you're trying to create and we'll help define the right production setup.</p>
        <a class="project-link" href={contactHref} data-analytics-event="project_cta" data-analytics-label="Start a project">START A PROJECT <span aria-hidden="true">→</span></a>
      </div>
  </div>
</section>

<style>
  .project-section {
    --start-bg: var(--off-white);
    --start-text: var(--near-black);
    --start-muted: #6E6E73;
    --start-line: #D2D2D7;
    background: var(--start-bg);
    color: var(--start-text);
    color-scheme: light;
  }

  .project-section[data-theme="dark"] {
    --start-bg: var(--pure-black);
    --start-text: var(--off-white);
    --start-line: rgba(210, 210, 215, .3);
    color-scheme: dark;
  }

  .project-section + :global(.site-footer) { border-top: 0; }

  .project-cta { --max-width: var(--content-default); display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 44px; border-top: 1px solid var(--start-line); padding-block: 56px 70px; }
  .project-cta h2 { margin: 0; font-size: clamp(48px, 6.5vw, 104px); line-height: .95; letter-spacing: -.05em; font-weight: 500; }
  .project-cta p { max-width: 420px; margin: 0 0 24px; color: var(--start-muted); line-height: 1.6; }
  .project-link { display: inline-flex; width: fit-content; align-items: center; gap: 20px; min-height: 48px; padding-inline: 20px; border-bottom: 1px solid var(--start-text); font-size: 13px; letter-spacing: .04em; }
  .project-cta a { transition: transform var(--interaction-motion); }
  .project-cta a:hover { transform: scale(1.015); }
  .project-cta a:active { transform: scale(0.985); }
  .project-cta a:focus-visible { outline: 2px solid var(--start-text); outline-offset: 6px; }
  @media (max-width: 768px) {
    .project-cta { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-block: 40px 48px; }
  }
</style>
