---
interface Props {
  title?: string;
  body?: string;
}

const {
  title = "HAVE A PROJECT IN MIND?",
  body = "Tell us what you're making, your timeline and your budget. We'll help shape the right production setup."
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const contactHref = `${base}/contact/`;
---

<section class="project-cta" aria-labelledby="project-cta-title">
  <h2 id="project-cta-title">{title}</h2>
  <div class="cta-copy">
    <p>{body}</p>
    <a
      href={contactHref}
      data-analytics-event="project_cta"
      data-analytics-label={title}
    >
      START A PROJECT <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .project-cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 64px;
    margin-top: var(--space-section);
    padding-block: clamp(64px, 8vw, 112px);
    border-top: 1px solid var(--line);
  }

  h2 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(44px, 6.5vw, 104px);
    font-weight: 500;
    line-height: .92;
    letter-spacing: -.055em;
  }

  .cta-copy {
    justify-self: end;
    width: min(100%, 480px);
  }

  p {
    margin: 0 0 32px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
  }

  a {
    display: flex;
    justify-content: space-between;
    gap: 48px;
    padding-block: 14px;
    border-block: 1px solid var(--line);
    font-size: 12px;
    letter-spacing: .1em;
    transition: border-color .2s ease;
  }

  a:hover {
    border-color: #666;
  }

  @media (max-width: 768px) {
    .project-cta {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      padding-block: 56px 72px;
    }

    h2 {
      font-size: clamp(42px, 13vw, 72px);
    }

    .cta-copy {
      justify-self: stretch;
      width: 100%;
    }
  }
</style>
