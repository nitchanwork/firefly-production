---
import { normalizeInstagramUrl } from '../../utils/instagram';
import type { PortfolioRatio } from '../../data/portfolio';

interface Props {
  instagramUrl: string;
  label: string;
  type: 'photography' | 'videography';
  ratio?: PortfolioRatio;
}

const {
  instagramUrl,
  label,
  type,
  ratio = type === 'photography' ? '4:5' : '9:16'
} = Astro.props;

const permalink = normalizeInstagramUrl(instagramUrl);
---

<firefly-instagram
  class:list={['instagram-embed', type]}
  data-ratio={ratio}
  aria-label={label}
  data-valid={Boolean(permalink)}
>
  <div class="embed-viewport">
    <div class="embed-canvas" data-embed-canvas></div>
    <p class="embed-loading" data-embed-loading>LOADING MEDIA</p>
  </div>

  <div class="embed-fallback" data-embed-fallback hidden>
    <span>POST UNAVAILABLE</span>
    <div class="fallback-actions">
      <button type="button" data-embed-retry>RETRY</button>
      {permalink && (
        <a
          href={permalink}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="instagram_fallback_open"
          data-analytics-label={label}
        >
          VIEW ON INSTAGRAM ↗
        </a>
      )}
    </div>
  </div>

  {permalink && (
    <template data-embed-template>
      <blockquote
        class="instagram-media"
        data-instgrm-permalink={permalink}
        data-instgrm-version="14"
      >
        <a href={permalink} target="_blank" rel="noopener noreferrer">Open post on Instagram</a>
      </blockquote>
    </template>
  )}

  <noscript>
    {permalink && (
      <a href={permalink} target="_blank" rel="noopener noreferrer">Open post on Instagram ↗</a>
    )}
  </noscript>
</firefly-instagram>

<script>
  import '../../scripts/instagramEmbeds';
</script>

<style>
  .instagram-embed {
    /* Offsets are in unscaled Instagram pixels; all mask tuning lives here. */
    --embed-native-width: 326px;
    --ig-1-1-offset: 54px;
    --ig-3-2-offset: 54px;
    --ig-4-3-offset: 54px;
    --ig-4-5-offset: 54px;
    --ig-5-4-offset: 54px;
    --ig-9-16-offset: 54px;
    --ig-16-9-offset: 54px;
    --ig-offset: var(--ig-4-5-offset);
    --ig-ratio: 4 / 5;
    --ig-zoom: 1;
    --ig-crop-top: 0px;
    --ig-crop-right: 0px;
    --ig-crop-bottom: 00px;
    --ig-crop-left: 0px;

    display: block;
    position: relative;
    min-width: 0;
    background: var(--bg);
  }

  .instagram-embed[data-ratio="1:1"] {
    --ig-ratio: 1 / 1;
    --ig-offset: var(--ig-1-1-offset);
  }

  .instagram-embed[data-ratio="3:2"] {
    --ig-ratio: 3 / 2;
    --ig-offset: var(--ig-3-2-offset);
  }

  .instagram-embed[data-ratio="4:3"] {
    --ig-ratio: 4 / 3;
    --ig-offset: var(--ig-4-3-offset);
  }

  .instagram-embed[data-ratio="5:4"] {
    --ig-ratio: 5 / 4;
    --ig-offset: var(--ig-5-4-offset);
  }

  .instagram-embed[data-ratio="4:3"],
  .instagram-embed[data-ratio="5:4"] {
    --bg: #000;
  }

  .instagram-embed[data-ratio="9:16"] {
    --ig-ratio: 9 / 16;
    --ig-offset: var(--ig-9-16-offset);
    /* Expand the portrait video inside Instagram's letterboxed 4:5 media area. */
    --ig-zoom: 1.422222;
  }

  .instagram-embed[data-ratio="16:9"] {
    --ig-ratio: 16 / 9;
    --ig-offset: var(--ig-16-9-offset);
  }

  .embed-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ig-ratio);
    border-radius: 18px;
    overflow: hidden;
    contain: layout paint;
    background: var(--bg);
  }

  .embed-canvas {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--embed-canvas-width, var(--embed-native-width));
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) scale(calc(var(--embed-scale, 1) * var(--ig-zoom))) translateY(calc(-1 * var(--ig-offset)));
    transform-origin: top center;
    clip-path: inset(var(--ig-crop-top) var(--ig-crop-right) var(--ig-crop-bottom) var(--ig-crop-left));
    transition: opacity .32s ease;
  }

  [data-ready] .embed-canvas {
    opacity: 1;
    pointer-events: auto;
  }

  .embed-canvas :global(.instagram-media) {
    display: block;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
  }

  .embed-loading,
  .embed-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 0;
    border: 1px solid var(--line);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, .018), transparent 45%),
      var(--bg);
    color: var(--muted);
    font-size: 9px;
    letter-spacing: .12em;
  }

  .embed-loading {
    border: 1px solid #000000;
    outline: none;
    box-shadow: none;
    background: #000000;
    color: #000000;
  }

  .embed-fallback {
    border-radius: 18px;
    overflow: hidden;
  }

  .embed-loading::before {
    display: none;
  }

  [hidden] {
    display: none !important;
  }

  .fallback-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 18px;
  }

  .embed-fallback a,
  .embed-fallback button {
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    letter-spacing: .08em;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .embed-fallback button:hover,
  .embed-fallback a:hover {
    color: #fff;
  }

</style>
