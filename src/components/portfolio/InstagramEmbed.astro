---
interface Props { instagramUrl: string }
const { instagramUrl } = Astro.props;
let permalink = '';
try {
  const url = new URL(instagramUrl.trim());
  const path = url.pathname.match(/^\/(p|reel)\/([A-Za-z0-9_-]+)\/?$/);
  if (url.protocol === 'https:' && ['instagram.com', 'www.instagram.com'].includes(url.hostname) && path) {
    permalink = `https://www.instagram.com/${path[1]}/${path[2]}/`;
  }
} catch {
  // Empty or incomplete URLs retain the intentional placeholder.
}
---

<div class="instagram-embed">
  {permalink ? (
    <>
      <!-- Omitting data-instgrm-captioned uses Instagram's caption-free embed. -->
      <blockquote class="instagram-media" data-instgrm-permalink={permalink} data-instgrm-version="14">
        <a href={permalink} target="_blank" rel="noopener noreferrer">View this work on Instagram</a>
      </blockquote>
      <a class="instagram-link" href={permalink} target="_blank" rel="noopener noreferrer">View on Instagram</a>
    </>
  ) : (
    <div class="media-placeholder"><span>INSTAGRAM WORK</span></div>
  )}
</div>

<style>
  .instagram-embed { min-width: 0; width: 100%; }
  .media-placeholder { display: grid; place-items: center; aspect-ratio: 4 / 3; background: #141414; border-block: 1px solid var(--line); }
  .media-placeholder span { color: var(--muted); font-size: 11px; letter-spacing: .12em; }
  blockquote { margin: 0; padding: 24px; }
  /* Size only the outer embed, without changing Instagram's internal UI or height. */
  .instagram-embed :global(.instagram-media) { width: 100% !important; min-width: 0 !important; max-width: 100% !important; margin: 0 !important; }
  .instagram-link { display: inline-block; margin-top: 12px; color: var(--muted); font-size: 12px; text-decoration: underline; text-underline-offset: 4px; }
  a:focus-visible { outline: 2px solid var(--text); outline-offset: 4px; }
</style>
