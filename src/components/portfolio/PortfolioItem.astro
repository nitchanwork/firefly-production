---
import type { PortfolioItem } from '../../data/portfolio';
import InstagramEmbed from './InstagramEmbed.astro';
interface Props { portfolioItem: PortfolioItem }
const { portfolioItem } = Astro.props;
---

<article class="portfolio-item" data-portfolio-category={portfolioItem.category} data-portfolio-brand={portfolioItem.client} aria-labelledby={`${portfolioItem.id}-title`}>
  <InstagramEmbed instagramUrl={portfolioItem.instagramUrl} />
  <div class="portfolio-caption">
    <p class="client">{portfolioItem.client}</p>
    <h2 id={`${portfolioItem.id}-title`}>{portfolioItem.title}</h2>
    <div class="portfolio-meta">
      <span>{portfolioItem.type}</span>
      <time datetime={String(portfolioItem.year)}>{portfolioItem.year}</time>
    </div>
  </div>
</article>

<style>
  .portfolio-item { min-width: 0; }
  .portfolio-caption { padding-top: 24px; overflow-wrap: anywhere; }
  .client { margin: 0 0 12px; color: var(--muted); font-size: 12px; letter-spacing: .06em; }
  h2 { margin: 0; font-size: clamp(26px, 3vw, 40px); font-weight: 400; line-height: 1.1; letter-spacing: -.04em; }
  .portfolio-meta { display: flex; justify-content: space-between; gap: 24px; border-top: 1px solid var(--line); padding-top: 16px; margin-top: 24px; font-size: 13px; color: var(--muted); }
</style>
