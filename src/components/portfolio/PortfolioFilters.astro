---
import { portfolioBrands, portfolioTypes } from '../../data/portfolio';
const types = [
  { id: 'all', label: 'ALL' },
  ...portfolioTypes,
];
---

<div class="portfolio-filters">
  <div class="filter-row" role="group" aria-label="Brand">
    <span class="filter-label">BRAND</span>
    <span class="filter-active-indicator" aria-hidden="true"></span>
    <button type="button" data-portfolio-brand-filter="all" aria-pressed="true" aria-controls="portfolio-grid" data-analytics-event="portfolio_filter_brand" data-analytics-label="ALL">ALL</button>
    {portfolioBrands.map(brand => <button type="button" data-portfolio-brand-filter={brand.id} aria-pressed="false" aria-controls="portfolio-grid" data-analytics-event="portfolio_filter_brand" data-analytics-label={brand.name}>{brand.name.toUpperCase()}</button>)}
  </div>
  <div class="filter-row" role="group" aria-label="Type">
    <span class="filter-label">TYPE</span>
    <span class="filter-active-indicator" aria-hidden="true"></span>
    {types.map(type => <button type="button" data-portfolio-type-filter={type.id} aria-pressed={type.id === 'all' ? 'true' : 'false'} aria-controls="portfolio-grid" data-analytics-event="portfolio_filter_type" data-analytics-label={type.label}>{type.label}</button>)}
  </div>
</div>

<script>
  const filterRows = document.querySelectorAll<HTMLElement>('.filter-row');

  filterRows.forEach(row => {
    const positionActiveIndicator = () => {
      const activeOption = row.querySelector<HTMLElement>('button[aria-pressed="true"]');
      const indicator = row.querySelector<HTMLElement>('.filter-active-indicator');
      if (!activeOption || !indicator) return;

      const rowBounds = row.getBoundingClientRect();
      const optionBounds = activeOption.getBoundingClientRect();

      row.style.setProperty('--indicator-x', `${optionBounds.left - rowBounds.left}px`);
      row.style.setProperty('--indicator-y', `${optionBounds.top - rowBounds.top}px`);
      row.style.setProperty('--indicator-width', `${optionBounds.width}px`);
      row.style.setProperty('--indicator-height', `${optionBounds.height}px`);
      row.classList.add('indicator-ready');
    };

    positionActiveIndicator();
    window.requestAnimationFrame(() => row.classList.add('indicator-transition-ready'));
    row.addEventListener('click', event => {
      if ((event.target as Element).closest('button')) {
        window.requestAnimationFrame(positionActiveIndicator);
      }
    });
    new ResizeObserver(positionActiveIndicator).observe(row);
  });
</script>

<style>
  .portfolio-filters {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 16px;
    width: 100%;
  }

  .filter-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    max-width: 100%;
    min-width: 0;
    overflow: visible;
    padding: 6px;
    border-radius: 999px;
    background: #1D1D1F;
    color: #F5F5F7;
    box-shadow: 0 8px 30px rgba(29, 29, 31, .10), 0 2px 8px rgba(29, 29, 31, .06);
  }

  .filter-label {
    flex: 0 0 auto;
    padding-inline: 10px 6px;
    color: #F5F5F7;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
  }

  button {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    min-height: 44px;
    padding: 10px 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 12px;
    letter-spacing: .05em;
    cursor: pointer;
    transition: transform var(--interaction-motion), color var(--interaction-motion);
  }

  button:hover {
    color: #F5F5F7;
    transform: scale(1.015);
  }

  button:active { transform: scale(0.985); }

  button[aria-pressed="true"] {
    color: #1D1D1F;
  }

  .filter-active-indicator {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    width: var(--indicator-width, 0px);
    height: var(--indicator-height, 0px);
    border: 1px solid rgba(255, 255, 255, .38);
    border-radius: 999px;
    background: rgba(245, 245, 247, .88);
    visibility: hidden;
    pointer-events: none;
    transform: translate3d(var(--indicator-x, 0px), var(--indicator-y, 0px), 0);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 1px 2px rgba(0, 0, 0, .18);
  }

  .filter-row.indicator-ready .filter-active-indicator { visibility: visible; }

  .filter-row.indicator-transition-ready .filter-active-indicator {
    transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1), width 360ms cubic-bezier(0.22, 1, 0.36, 1), height 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  button:focus-visible { outline: 2px solid #F5F5F7; outline-offset: 2px; }

  @media (max-width: 768px) {
    .portfolio-filters {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }
    .filter-row {
      width: 100%;
      flex-wrap: wrap;
      gap: clamp(4px, 1.2vw, 6px);
      padding: 6px;
    }

    .filter-label {
      padding-inline: 8px 4px;
      font-size: clamp(10px, 2.8vw, 12px);
    }

    button {
      min-height: 38px;
      padding: 8px clamp(7px, 1.7vw, 10px);
      font-size: clamp(10px, 2.6vw, 12px);
    }
  }
</style>
