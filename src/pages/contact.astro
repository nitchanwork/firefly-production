---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact | Firefly">
  <section class="contact container" lang="en" aria-labelledby="contact-title">
    <p class="contact-label">CONTACT</p>
    <h1 id="contact-title">LET'S MAKE<br />SOMETHING<br />WORTH SEEING.</h1>
    <div class="contact-details">
      <p>Have a project in mind,<br />or just want to talk about what we could create together?</p>
      <a class="contact-email" href="mailto:nitchan@jytecom.com">nitchan@jytecom.com</a>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    min-height: 100svh;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-content: center;
    column-gap: 24px;
    row-gap: 56px;
    padding-block: 140px 80px;
  }

  .contact-label {
    grid-column: 1 / 3;
    align-self: start;
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: .1em;
  }

  h1 {
    grid-column: 3 / -1;
    margin: 0;
    font-size: clamp(48px, 8vw, 128px);
    font-weight: 500;
    line-height: .95;
    letter-spacing: -.06em;
  }

  .contact-details {
    grid-column: 7 / -1;
    min-width: 0;
  }

  .contact-details p {
    max-width: 420px;
    margin: 0 0 28px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
  }

  .contact-email {
    display: inline-block;
    max-width: 100%;
    padding-block: 8px;
    font-size: clamp(24px, 3vw, 44px);
    line-height: 1.2;
    letter-spacing: -.04em;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: .22em;
    transition: opacity .2s ease;
  }

  .contact-email:hover { opacity: .65; }
  .contact-email:focus-visible { outline: 2px solid var(--text); outline-offset: 6px; }

  @media (max-width: 768px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding-block: 120px 56px;
    }
    .contact-label, h1, .contact-details { grid-column: 1; }
    .contact-label { margin: 0; }
    h1 { font-size: clamp(30px, 10.5vw, 80px); }
    .contact-details { margin-top: 16px; }
    .contact-email { font-size: clamp(24px, 5.5vw, 40px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-email { transition: none; }
  }
</style>
