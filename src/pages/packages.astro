---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCTA from "../components/ProjectCTA.astro";
import ServiceList from "../components/services/ServiceList.astro";
---

<BaseLayout
  title="Services & Packages | FIREFLY PRODUCTION HOUSE"
  contentWidth="medium"
  description="Photography, videography, social content and creative production services from Firefly Production House in Bangkok."
>
  <div class="packages-page container" lang="en">
    <header class="packages-hero">
      <h1 class="page-headline">SERVICES &amp; PACKAGES</h1>
      <p>Creative production services built around your scale, goals and budget.</p>
    </header>
    <ServiceList />
  </div>
  <ProjectCTA slot="project-cta" theme="light" />
</BaseLayout>

<style>
  .packages-page { --max-width: var(--content-medium); }
  .packages-hero { padding-block: 160px 80px; }
  h1 { margin: 0; }
  .packages-hero p { max-width: 420px; margin: 40px 0 0; color: var(--muted); font-size: 16px; line-height: 1.6; }
  @media (max-width: 768px) {
    .packages-hero { padding-block: 120px 56px; }
  }
</style>
