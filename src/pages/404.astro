---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
---

<BaseLayout
  title="404 | Firefly Production House"
  description="The requested page could not be found."
  noindex={true}
>
  <section class="not-found container" aria-labelledby="not-found-title">
    <p class="code">404</p>
    <h1 id="not-found-title">FRAME NOT FOUND.</h1>
    <p class="message">The page you’re looking for isn’t in this cut.</p>

    <div class="actions">
      <a
        href={href("/")}
        data-analytics-event="404_navigation"
        data-analytics-label="Back home"
      >
        BACK HOME <span aria-hidden="true">→</span>
      </a>
      <a
        href={href("/portfolio/")}
        data-analytics-event="404_navigation"
        data-analytics-label="View portfolio"
      >
        VIEW PORTFOLIO <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 128px 72px;
  }

  .code {
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: .14em;
  }

  h1 {
    max-width: 1100px;
    margin: 0;
    font-size: clamp(56px, 10vw, 156px);
    font-weight: 700;
    line-height: .88;
    letter-spacing: -.065em;
  }

  .message {
    max-width: 520px;
    margin: 36px 0 0;
    color: var(--muted);
    font-size: clamp(16px, 2vw, 22px);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 36px;
    margin-top: 64px;
  }

  .actions a {
    display: inline-flex;
    justify-content: space-between;
    gap: 48px;
    min-width: 220px;
    padding-block: 14px;
    border-block: 1px solid var(--line);
    font-size: 11px;
    letter-spacing: .1em;
    transition: border-color .2s ease;
  }

  .actions a:hover {
    border-color: #666;
  }

  @media (max-width: 600px) {
    .not-found {
      padding-top: 112px;
    }

    h1 {
      font-size: clamp(52px, 17vw, 92px);
    }

    .actions {
      display: grid;
      gap: 12px;
      margin-top: 48px;
    }

    .actions a {
      width: 100%;
    }
  }
</style>
